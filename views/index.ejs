<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ВЕКТОР — криптообмінник</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/content.css">
    <link rel="stylesheet" href="/css/exchange.css">
    <link rel="stylesheet" href="/css/order.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>


    <%- include('partials/header') %>

    <main>
        <div class="main-content">
            <section class="mainContent-text">
                <p>ГОТІВКА В ОБМІННИКУ</p>
                <h2>Твоя готівка.</h2>
                <h2 class="green-text">У потрібний час.</h2>
                <p>Вкажи суму, обери крипту, відділення та зручний час. Ми підтвердимо наявність готівки й зустрінемо тебе особисто</p>
                <ul class="features-list">
                    <li>
                        <span class="check-icon green-text"><i class="bi bi-check-lg"></i></span> Готівка в обміннику
                    </li>
                    <li>
                        <span class="check-icon green-text"><i class="bi bi-check-lg"></i></span> P2P як альтернатива
                    </li>
                </ul>

                <%
                    // Українські форми множини: 1 відділення, 2 слоти, 5 слотів
                    const plural = (n, one, few, many) => {
                        const m10 = n % 10, m100 = n % 100;
                        if (m10 === 1 && m100 !== 11) return one;
                        if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
                        return many;
                    };
                %>
                <dl class="stats">
                    <div>
                        <dt><%= branches.length %></dt>
                        <dd><%= plural(branches.length, 'відділення', 'відділення', 'відділень') %></dd>
                    </div>
                    <div>
                        <dt><%= slots.length %></dt>
                        <dd><%= plural(slots.length, 'слот', 'слоти', 'слотів') %> щодня</dd>
                    </div>
                    <div>
                        <dt><%= cryptos.length %></dt>
                        <dd><%= plural(cryptos.length, 'криптовалюта', 'криптовалюти', 'криптовалют') %></dd>
                    </div>
                </dl>

                <ol class="how">
                    <li class="step">
                        <span class="step__num">1</span>
                        <strong>Заявка</strong>
                        <span>Сума, крипта, відділення й час</span>
                    </li>
                    <li class="step">
                        <span class="step__num">2</span>
                        <strong>Підтвердження</strong>
                        <span>Перевіряємо готівку й курс</span>
                    </li>
                    <li class="step">
                        <span class="step__num">3</span>
                        <strong>Готівка</strong>
                        <span>Забираєш у відділенні</span>
                    </li>
                </ol>
            </section>
            <section class="table">
                <%- include('partials/exchange-form') %>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/exchange.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
